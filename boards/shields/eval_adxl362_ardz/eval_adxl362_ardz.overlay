#include <zephyr/dt-bindings/sensor/adxl362.h>
#include <zephyr/dt-bindings/gpio/arduino-header-r3.h>

/ {
	chosen {
		zephyr,display = &st7565r_eval_adxl362_ardz;
	};
};

&arduino_spi {
	status = "okay";

	cs-gpios = <&arduino_header ARDUINO_HEADER_R3_D10 GPIO_ACTIVE_LOW>,
		   <&arduino_header ARDUINO_HEADER_R3_D7 GPIO_ACTIVE_LOW>;

	adxl362_eval_adxl362_ardz: adxl362@0 {
		compatible = "adi,adxl362";
		reg = <0x0>;
		spi-max-frequency = <DT_FREQ_M(1)>;
		int1-gpios = <&arduino_header ARDUINO_HEADER_R3_D2 GPIO_ACTIVE_HIGH>;
		fifo-mode = <ADXL362_FIFO_MODE_STREAM>;
		fifo-watermark = <0x80>;
		status = "okay";
	};

	st7565r_eval_adxl362_ardz: st7565r@1 {
		compatible = "sitronix,st7565r";
		reg = <0x1>;
		spi-max-frequency = <DT_FREQ_M(1)>;
		reset-gpios = <&arduino_header ARDUINO_HEADER_R3_D3 GPIO_ACTIVE_LOW>;
		data-cmd-gpios = <&arduino_header ARDUINO_HEADER_R3_D5 GPIO_ACTIVE_HIGH>;
		bl-gpios = <&arduino_header ARDUINO_HEADER_R3_D8 GPIO_ACTIVE_HIGH>;
		width = <128>;
		height = <32>;
		resistor-ratio = <1>;
		lcd-bias = <9>;
		com-invdir;
	};
};
